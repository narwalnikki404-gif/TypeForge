# ─── TypeForge Environment Variables ──────────────────────────────────────────
# Copy this to .env for local dev.
# On Railway, set these via the Railway dashboard → your service → Variables.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ────────────────────────────────────────────────────────────────────
# Railway provides this automatically when you add a PostgreSQL plugin.
DATABASE_URL=postgresql://user:password@localhost:5432/typeforge

# ── Session ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Admin ────────────────────────────────────────────────────────────────────────
# Used by scripts/extract-paragraphs.js to push paragraphs to the API.
ADMIN_TOKEN=replace-with-a-strong-random-token

# ── Paragraph Extraction ─────────────────────────────────────────────────────────
API_URL=https://your-app.up.railway.app
EXAM_ID=general
BATCH_SIZE=7

# ── Frontend URL (CORS) ──────────────────────────────────────────────────────────
FRONTEND_URL=https://your-app.up.railway.app
